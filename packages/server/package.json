    "fastify-plugin": "^6.0.0",
    "pg": "^8.16.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.1",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
